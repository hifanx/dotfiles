{
  "lastChangelogVersion": "1.3.0",
  "theme": "isekai",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "high",
  "skills": [
    "~/.config/pi/.agents/skills"
  ],
  "enableInstallTelemetry": false,
  "showCacheMissNotices": true,
  "showHardwareCursor": true,
  "packages": [
    {
      "source": "npm:@dietrichgebert/ponytail",
      "skills": [
        "+skills/ponytail/SKILL.md",
        "-skills/ponytail-debt/SKILL.md",
        "-skills/ponytail-gain/SKILL.md",
        "-skills/ponytail-audit/SKILL.md"
      ]
    },
    "npm:pi-caveman",
    "npm:@juicesharp/rpiv-todo",
    "npm:@juicesharp/rpiv-btw",
    "npm:pi-web-access",
    "npm:@narumitw/pi-usage",
    "npm:pi-zentui",
    "npm:pi-memory",
    {
      "source": "npm:pi-cc-extensions",
      "themes": [
        "-themes/cc-dark.json",
        "-themes/cc-light.json"
      ]
    },
    "npm:pi-mcp-adapter",
    "npm:@tintinweb/pi-subagents"
  ],
  "hideThinkingBlock": true,
  "extensions": [
    "-builtin:mcp"
  ]
}
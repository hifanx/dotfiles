{
  "lastChangelogVersion": "1.3.0",
  "theme": "isekai",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "high",
  "skills": [
    "~/.config/pi/.agents/skills"
  ],
  "enableInstallTelemetry": false,
  "showCacheMissNotices": true,
  "showHardwareCursor": true,
  "packages": [
    "npm:@dietrichgebert/ponytail",
    "npm:pi-caveman",
    "npm:pi-web-access",
    "npm:@narumitw/pi-usage",
    "npm:pi-zentui",
    "npm:pi-mcp-adapter",
    "npm:pi-cc-extensions",
    "../../git/pi-utils"
  ],
  "hideThinkingBlock": true,
  "extensions": [
    "-builtin:mcp"
  ],
  "subagents": {
    "defaultModel": "openai-codex/gpt-6-luna",
    "agentOverrides": {
      "scout": {
        "thinking": "low",
        "inheritGlobalContext": true
      },
      "worker": {
        "model": "chatanywhere/deepseek-v4.1-flash",
        "thinking": "max",
        "inheritGlobalContext": true
      },
      "delegate": {
        "thinking": "high",
        "inheritGlobalContext": true
      },
      "researcher": {
        "thinking": "high",
        "inheritGlobalContext": true
      },
      "reviewer": {
        "model": "gpt-6-astra",
        "thinking": "high",
        "inheritGlobalContext": true
      },
      "evidence-auditor": {
        "model": "inherit",
        "thinking": "high",
        "inheritGlobalContext": true
      },
      "oracle": {
        "model": "gpt-6-astra",
        "thinking": "high",
        "inheritGlobalContext": true
      }
    }
  }
}
{
  "lastChangelogVersion": "1.5.0",
  "theme": "isekai",
  "defaultProvider": "claude-code",
  "defaultModel": "claude-opus-5-5",
  "defaultThinkingLevel": "high",
  "skills": [
    "~/.config/pi/.agents/skills"
  ],
  "enableInstallTelemetry": false,
  "showCacheMissNotices": true,
  "showHardwareCursor": true,
  "packages": [
    "npm:pi-web-access",
    "npm:@dietrichgebert/ponytail",
    "npm:pi-zentui",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-cc-extensions",
    "https://github.com/earendil-works/pi-claude-code",
    "~/git/pi-utils"
  ],
  "hideThinkingBlock": true,
  "subagents": {
    "defaultModel": "openai-codex/gpt-6-luna",
    "agentOverrides": {
      "scout": {
        "thinking": "low",
        "inheritGlobalContext": true
      },
      "worker": {
        "model": "chatanywhere/deepseek-v4.1-flash",
        "thinking": "max",
        "inheritGlobalContext": true
      },
      "delegate": {
        "thinking": "high",
        "inheritGlobalContext": true
      },
      "researcher": {
        "thinking": "high",
        "inheritGlobalContext": true
      },
      "reviewer": {
        "model": "gpt-6-astra",
        "thinking": "high",
        "inheritGlobalContext": true
      },
      "evidence-auditor": {
        "model": "inherit",
        "thinking": "high",
        "inheritGlobalContext": true
      },
      "oracle": {
        "model": "gpt-6-astra",
        "thinking": "high",
        "inheritGlobalContext": true
      }
    }
  },
  "extensionChangelogVersions": {
    "{\"source\":\"npm:pi-web-access\",\"scope\":\"user\"}": "0.47.0"
  }
}
{
  "lastChangelogVersion": "1.3.0",
  "theme": "isekai",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "high",
  "skills": ["~/.config/pi/.agents/skills"],
  "enableInstallTelemetry": false,
  "showCacheMissNotices": true,
  "showHardwareCursor": true,
  "packages": [
    {
      "source": "npm:@dietrichgebert/ponytail",
      "skills": [
        "+skills/ponytail/SKILL.md",
        "-skills/ponytail-debt/SKILL.md",
        "-skills/ponytail-gain/SKILL.md",
        "-skills/ponytail-audit/SKILL.md"
      ]
    },
    "npm:pi-caveman",
    "npm:@juicesharp/rpiv-todo",
    "npm:@juicesharp/rpiv-btw",
    "npm:pi-web-access",
    "npm:@narumitw/pi-usage",
    "npm:pi-zentui",
    "npm:pi-mcp-adapter",
    "npm:pi-subagents",
    "npm:pi-cc-extensions"
  ],
  "hideThinkingBlock": true,
  "extensions": ["-builtin:mcp"],
  "subagents": {
    "defaultModel": "openai-codex/gpt-6-luna",
    "agentOverrides": {
      "scout": {
        "thinking": "low",
        "inheritGlobalContext": true
      },
      "worker": {
        "thinking": "max",
        "inheritGlobalContext": true
      },
      "delegate": {
        "thinking": "high",
        "inheritGlobalContext": true
      },
      "researcher": {
        "thinking": "high",
        "inheritGlobalContext": true
      },
      "reviewer": {
        "model": "gpt-6-astra",
        "thinking": "high",
        "inheritGlobalContext": true
      },
      "evidence-auditor": {
        "model": "inherit",
        "thinking": "high",
        "inheritGlobalContext": true
      },
      "oracle": {
        "model": "gpt-6-astra",
        "thinking": "high",
        "inheritGlobalContext": true
      }
    }
  }
}

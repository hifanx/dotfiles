{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": ["openrouter"],
  "model": "chatanywhere/claude-sonnet-4-6",
  "small_model": "opencode/big-pickle",
  "provider": {
    "chatanywhere": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Chat Anywhere",
      "options": {
        "baseURL": "{env:CHATANYWHERE_BASEURL}",
        "apiKey": "{env:CHATANYWHERE_API_KEY}"
      },
      "models": {
        "claude-sonnet-4-6": {
          "name": "claude-sonnet-4-6"
        },
        "claude-sonnet-5": {
          "name": "claude-sonnet-5"
        },
        "claude-opus-4-6": {
          "name": "claude-opus-4-6"
        },
        "claude-opus-4-7": {
          "name": "claude-opus-4-7"
        },
        "claude-opus-4-8": {
          "name": "claude-opus-4-8"
        },
        "claude-opus-5": {
          "name": "claude-opus-5"
        },
        "gpt-5.4": {
          "name": "gpt-5.4"
        },
        "gpt-5.5": {
          "name": "gpt-5.5"
        }
      }
    }
  },
  "plugin": ["@dietrichgebert/ponytail"]
}
